        <oboInOwl:hasDbXref>Reactome:R-HSA-427570</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-9659568</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-9712204</oboInOwl:hasDbXref>
