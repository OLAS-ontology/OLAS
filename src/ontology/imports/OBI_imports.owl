        <obo:IAO_0000115 xml:lang="en">A role borne by a biological or chemical entity that participates or has molecular components that participate in a chemical reaction.</obo:IAO_0000115>
        <obo:IAO_0000117>Sebastian Duesing</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
