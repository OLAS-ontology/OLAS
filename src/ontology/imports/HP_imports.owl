    <!-- http://purl.obolibrary.org/obo/HP_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <obo:IAO_0000115>A phenotypic abnormality.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasDbXref>UMLS:C4021819</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Organ abnormality</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000118</oboInOwl:id>
        <rdfs:comment>This is the root of the phenotypic abnormality subontology of the HPO.</rdfs:comment>
        <rdfs:label>Phenotypic abnormality</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0002715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0002715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An abnormality of the immune system.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/hp.owl"/>
        <oboInOwl:hasAlternativeId>HP:0003257</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0003346</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0010986</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>UMLS:C4021753</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Abnormality of the immune system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Immunological abnormality</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0002715</oboInOwl:id>
        <rdfs:comment>The immune system is composed of organs and interdependent cell types that collectively protect the body from infections and from the growth of tumor cells. The organs of the immune system comprise the bone marrow, the spleen, the thymus,the lymph nodes, and the cell types comprise B cells, T cells, natural killer cells, granulocytes,dendritic cells, and macrophages.</rdfs:comment>
        <rdfs:label>Abnormality of the immune system</rdfs:label>
    </owl:Class>
    


