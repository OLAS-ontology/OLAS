        </rdfs:subClassOf>
        <obo:IAO_0000115>A cftr isoform 1 that includes at least one phosphorylated residue.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
        <oboInOwl:hasExactSynonym>CFTR/iso:1/PhosRes+</oboInOwl:hasExactSynonym>
