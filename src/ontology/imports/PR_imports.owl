        <oboInOwl:id>PR:000001049</oboInOwl:id>
        <rdfs:comment>Category=modification.</rdfs:comment>
        <rdfs:label>cftr isoform 1 N-glycosylated 1</rdfs:label>
    </owl:Class>
    


