    <!-- http://purl.obolibrary.org/obo/PR_000001048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001048">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/PR_000001045"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MOD_00693"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000001045"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000037069"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MOD_00693"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cftr isoform 1 that includes at least one glycosylated residue.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
        <oboInOwl:hasExactSynonym>CFTR/iso:1/GlycoRes+</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>protein</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PR:000001048</oboInOwl:id>
        <rdfs:comment>Category=modification.</rdfs:comment>
        <rdfs:label>cftr isoform 1 glycosylated form</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PR_000001049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000001049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000001048"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MOD_00160"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cftr isoform 1 glycosylated form in which the glycosylation is at two Asn residues within the N{P}[ST]{P} motif, located in the fourth extracellular loop. Example: UniProtKB:P13569-1, Asn-894/Asn-900, MOD:00160.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
        <oboInOwl:hasExactSynonym>CFTR/iso:1/NGlyco:1</oboInOwl:hasExactSynonym>
