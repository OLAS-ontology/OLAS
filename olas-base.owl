     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ncbitaxon="http://purl.obolibrary.org/obo/ncbitaxon#">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/olas.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/olas/releases/2025-02-06/olas.owl"/>
        <dc:contributor>Bob Dysko</dc:contributor>
        <dc:creator xml:lang="en">Jean Nemzek</dc:creator>
        <dc:creator>Jie Zheng</dc:creator>
        <dc:creator xml:lang="en">Yongqun &quot;Oliver&quot; He (YH)</dc:creator>
        <dc:date xml:lang="en">09-05-2024</dc:date>
        <dc:description xml:lang="en">OLAS is a biomedical ontology in the area of laboratory animal science.</dc:description>
        <dc:format xml:lang="en">OWL-DL</dc:format>
        <dc:subject xml:lang="en">laboratory animal science</dc:subject>
        <dc:title xml:lang="en">OLAS: Ontology of Laboratory Animal Science</dc:title>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <owl:versionInfo>2025-02-06</owl:versionInfo>
        <owl:versionInfo xml:lang="en">Vision Release: 1.0.25</owl:versionInfo>
    </owl:Ontology>
    


