        <obo:IAO_0000112>A syringe, a beaker</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A contain function is a function to constrain a material entities location in space</obo:IAO_0000115>
        <obo:IAO_0000117>Bill Bug</obo:IAO_0000117>
        <obo:IAO_0000117>Daniel Schober</obo:IAO_0000117>
        <obo:IAO_0000117>Frank Gibson</obo:IAO_0000117>
        <obo:IAO_0000117>Melanie Courtot</obo:IAO_0000117>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">contain function</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000111>assay objective</obo:IAO_0000111>
        <obo:IAO_0000112>the objective to determine the weight of a mouse.</obo:IAO_0000112>
