        <oboInOwl:hasExactSynonym>FLICE2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ICE-like apoptotic protease 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>apoptotic protease Mch-4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>protein</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>MCH4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>PR:000002310</oboInOwl:id>
        <rdfs:comment>Category=gene. Not found in mouse.</rdfs:comment>
        <rdfs:label>caspase-10</rdfs:label>
    </owl:Class>
    


