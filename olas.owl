    <!-- http://purl.obolibrary.org/obo/GO_0006412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115>The cellular metabolic process in which a protein is formed, using the sequence of a mature mRNA or circRNA molecule to specify the sequence of amino acids in a polypeptide chain. Translation is mediated by the ribosome, and begins with the formation of a ternary complex between aminoacylated initiator methionine tRNA, GTP, and initiation factor 2, which subsequently associates with the small subunit of the ribosome and an mRNA or circRNA. Translation ends with the release of a polypeptide chain from the ribosome.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <oboInOwl:hasAlternativeId>GO:0006416</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0006453</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0043037</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Translation_(genetics)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>protein anabolism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protein biosynthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protein biosynthetic process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protein formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protein synthesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>protein translation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0006412</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_candida"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_chembl"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_drosophila"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_euk_cellular_processes_ribbon"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_metagenomics"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_pir"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_plant"/>
