        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ogms.owl"/>
        <rdfs:label>treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000096 -->

