                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A caspase-8-like protease that is a translation product of the human CASP10 gene or a 1:1 ortholog thereof.</obo:IAO_0000115>
