        <oboInOwl:hasDbXref>IUPHARobj:1626</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PIRSF:PIRSF500655</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CASP-10</oboInOwl:hasExactSynonym>
